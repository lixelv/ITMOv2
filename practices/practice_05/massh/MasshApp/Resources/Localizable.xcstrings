      }
    },
    "Status": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус"
          }
        }
      }
    },
    "Swap": {
      "shouldTranslate": false
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система"
          }
        }
      }
    },
    "The Agent is a small massh service that reports on the Server through an SSH tunnel. The terminal and status work without it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent — небольшой сервис massh, который отдаёт сведения о Server через SSH-туннель. Без него работают терминал и статус."
          }
        }
      }
    },
    "The Agent on %@ sends format %lld, which this build of massh does not understand. Update massh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The Agent on %1$@ sends format %2$lld, which this build of massh does not understand. Update massh."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent на %1$@ отдаёт формат %2$lld, а эта сборка massh его не понимает. Обновите massh."
          }
        }
      }
    },
    "The Host block will be removed from %@. A backup, config.massh.bak, is made before writing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блок Host будет удалён из %@. Перед записью делается бэкап config.massh.bak."
          }
        }
      }
    },
    "The Server runs Agent %@; massh ships %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The Server runs Agent %1$@; massh ships %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Server Agent %1$@, в massh — %2$@."
          }
        }
      }
    },
    "The installer replaces the binary and restarts the service. You type the sudo password in the terminal tab.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установщик заменит бинарник и перезапустит сервис. Пароль sudo вводится в терминальной вкладке."
          }
        }
      }
    },
    "The massh-agent service, its binary and the massh user will be removed. You type the sudo password in the terminal tab.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены сервис massh-agent, бинарник и пользователь massh. Пароль sudo вводится в терминальной вкладке."
          }
        }
      }
    },
    "The port is a number from 1 to 65535": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт — число от 1 до 65535"
          }
        }
      }
    },
    "The terminal and status work without the Agent. System details, ports, processes and containers appear once it is installed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал и статус работают и без Agent. Сведения о системе, портах, процессах и контейнерах появятся после установки."
          }
        }
      }
    },
    "This Server has no Docker, or the Agent cannot reach it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Server нет Docker, или Agent не может к нему обратиться."
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время"
          }
        }
      }
    },
    "Unknown: the Server is behind a Bastion with no open connection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown: Server за Bastion, а соединения с Bastion нет"
          }
        }
      }
    },
    "Update": {
      "localizations": {
