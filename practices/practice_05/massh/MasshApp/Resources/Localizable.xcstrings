            "value": "Рабочая область"
          }
        }
      }
    },
    "attempt %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "попытка %lld"
          }
        }
      }
    },
    "massh": {
      "shouldTranslate": false
    },
    "massh uploads the Agent and opens a terminal tab with the installer. You type the sudo password yourself — massh never sees it. The Agent runs as a systemd service under the massh user and listens on localhost only.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "massh загрузит Agent и откроет терминальную вкладку с установщиком. Пароль sudo вы вводите сами — massh его не видит. Agent работает как systemd-сервис от пользователя massh и слушает только localhost."
          }
        }
      }
    },
